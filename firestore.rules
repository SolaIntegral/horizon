rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /actions/{actionId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /workSessions/{sessionId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    // Doc id is `${userId}_${date}` and may not exist yet on first read
    // (subscribeDailyPlan/subscribeDailyReview listen before any plan for
    // today has been created), so ownership can't be checked via
    // resource.data (null on a nonexistent doc) — check the id prefix instead,
    // same reasoning as userSettings below.
    match /dailyPlans/{planId} {
      allow read, delete: if isSignedIn() && planId.split('_')[0] == request.auth.uid;
      allow create, update: if isSignedIn() && planId.split('_')[0] == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /dailyReviews/{reviewId} {
      allow read, delete: if isSignedIn() && reviewId.split('_')[0] == request.auth.uid;
      allow create, update: if isSignedIn() && reviewId.split('_')[0] == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /growthLogs/{logId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /features/{featureId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /ideas/{ideaId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }
  }
}
