rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /actions/{actionId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /workSessions/{sessionId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /progressNotes/{noteId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /growthLogs/{logId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /features/{featureId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }

    match /ideas/{ideaId} {
      allow read, update, delete: if ownsDoc();
      allow create: if ownsIncomingDoc();
    }
  }
}
